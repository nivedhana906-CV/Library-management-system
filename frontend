```html
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Library Management System</title>


<style>

/* =========================
   GENERAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6f8;
}


/* =========================
   HEADER
========================= */

header {
    background: #2c3e50;
    color: white;
    text-align: center;
    padding: 25px;
}

header h1 {
    margin-bottom: 8px;
}


/* =========================
   CONTAINER
========================= */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 30px auto;
}


/* =========================
   DASHBOARD
========================= */

.dashboard {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
}

.card {
    background: white;
    flex: 1;
    padding: 20px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 2px 8px #ccc;
}

.card h2 {
    margin-top: 10px;
    color: #2980b9;
}


/* =========================
   FORM
========================= */

.form-box {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px #ccc;
}

.form-box h2 {
    margin-bottom: 15px;
    color: #2c3e50;
}

input,
select {
    padding: 12px;
    margin: 5px;
    border: 1px solid #ccc;
    border-radius: 5px;
}


button {
    padding: 10px 16px;
    margin: 5px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.add-btn {
    background: green;
    color: white;
}

.clear-btn {
    background: #777;
    color: white;
}


/* =========================
   SEARCH
========================= */

.search-box {
    margin: 25px 0;
}

.search-box input {
    width: 100%;
    margin: 0;
}


/* =========================
   TABLE
========================= */

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    box-shadow: 0 2px 8px #ccc;
}

th {
    background: #34495e;
    color: white;
    padding: 12px;
}

td {
    padding: 12px;
    text-align: center;
    border: 1px solid #ddd;
}

tr:nth-child(even) {
    background: #f2f2f2;
}


/* =========================
   ACTION BUTTONS
========================= */

.edit-btn {
    background: orange;
    color: white;
}

.delete-btn {
    background: red;
    color: white;
}


/* =========================
   MOBILE
========================= */

@media(max-width: 700px) {

    .dashboard {
        flex-direction: column;
    }

    input,
    select {
        width: 100%;
        margin: 5px 0;
    }

    table {
        font-size: 12px;
    }

    th,
    td {
        padding: 8px;
    }
}

</style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header>

<h1>📚 Library Management System</h1>

<p>Simple Library Book Management</p>

</header>


<div class="container">


<!-- =========================
     DASHBOARD
========================= -->

<div class="dashboard">

<div class="card">

<p>Total Books</p>

<h2 id="totalBooks">0</h2>

</div>


<div class="card">

<p>Available Books</p>

<h2 id="availableBooks">0</h2>

</div>


<div class="card">

<p>Issued Books</p>

<h2 id="issuedBooks">0</h2>

</div>

</div>


<!-- =========================
     BOOK FORM
========================= -->

<div class="form-box">

<h2>📖 Add Book</h2>


<input
type="text"
id="bookName"
placeholder="Book Name"
>


<input
type="text"
id="author"
placeholder="Author Name"
>


<input
type="text"
id="bookId"
placeholder="Book ID"
>


<input
type="text"
id="category"
placeholder="Category"
>


<select id="status">

<option value="Available">
Available
</option>

<option value="Issued">
Issued
</option>

</select>


<br>


<button
class="add-btn"
onclick="addBook()">

Add Book

</button>


<button
class="clear-btn"
onclick="clearForm()">

Clear

</button>

</div>


<!-- =========================
     SEARCH
========================= -->

<div class="search-box">

<input
type="text"
id="search"
placeholder="🔍 Search Book..."
onkeyup="displayBooks()"
>

</div>


<!-- =========================
     BOOK TABLE
========================= -->

<table>

<thead>

<tr>

<th>S.No</th>

<th>Book Name</th>

<th>Author</th>

<th>Book ID</th>

<th>Category</th>

<th>Status</th>

<th>Action</th>

</tr>

</thead>


<tbody id="bookTable">

</tbody>

</table>


</div>


<!-- =========================
     JAVASCRIPT
========================= -->

<script>


let books = [];

let editIndex = -1;


/* =========================
   ADD BOOK
========================= */

function addBook() {

let bookName =
document.getElementById("bookName").value;

let author =
document.getElementById("author").value;

let bookId =
document.getElementById("bookId").value;

let category =
document.getElementById("category").value;

let status =
document.getElementById("status").value;


if (
bookName === "" ||
author === "" ||
bookId === "" ||
category === ""
) {

alert("Please fill all fields!");

return;

}


let book = {

bookName: bookName,

author: author,

bookId: bookId,

category: category,

status: status

};


books.push(book);


alert("Book added successfully!");


clearForm();

displayBooks();

}


/* =========================
   DISPLAY BOOKS
========================= */

function displayBooks() {

let table =
document.getElementById("bookTable");

let search =
document.getElementById("search").value
.toLowerCase();


table.innerHTML = "";


books.forEach(function(book, index) {


let text =

book.bookName.toLowerCase() +

book.author.toLowerCase() +

book.bookId.toLowerCase() +

book.category.toLowerCase();


if (text.includes(search)) {


let row = `

<tr>

<td>${index + 1}</td>

<td>${book.bookName}</td>

<td>${book.author}</td>

<td>${book.bookId}</td>

<td>${book.category}</td>

<td>${book.status}</td>

<td>

<button
class="edit-btn"
onclick="editBook(${index})">

Edit

</button>


<button
class="delete-btn"
onclick="deleteBook(${index})">

Delete

</button>

</td>

</tr>

`;


table.innerHTML += row;

}

});


updateDashboard();

}


/* =========================
   EDIT BOOK
========================= */

function editBook(index) {

let book = books[index];


let bookName =
prompt("Enter Book Name:", book.bookName);

let author =
prompt("Enter Author Name:", book.author);

let bookId =
prompt("Enter Book ID:", book.bookId);

let category =
prompt("Enter Category:", book.category);

let status =
prompt(
"Enter Status (Available/Issued):",
book.status
);


if (
bookName === null ||
author === null ||
bookId === null ||
category === null ||
status === null
) {

return;

}


books[index] = {

bookName: bookName,

author: author,

bookId: bookId,

category: category,

status: status

};


alert("Book updated successfully!");


displayBooks();

}


/* =========================
   DELETE BOOK
========================= */

function deleteBook(index) {

let confirmDelete =
confirm("Are you sure you want to delete this book?");


if (confirmDelete) {

books.splice(index, 1);

alert("Book deleted successfully!");

displayBooks();

}

}


/* =========================
   CLEAR FORM
========================= */

function clearForm() {

document.getElementById("bookName").value = "";

document.getElementById("author").value = "";

document.getElementById("bookId").value = "";

document.getElementById("category").value = "";

document.getElementById("status").value =
"Available";

}


/* =========================
   DASHBOARD
========================= */

function updateDashboard() {

document.getElementById("totalBooks")
.innerText = books.length;


document.getElementById("availableBooks")
.innerText =

books.filter(function(book) {

return book.status === "Available";

}).length;


document.getElementById("issuedBooks")
.innerText =

books.filter(function(book) {

return book.status === "Issued";

}).length;

}


/* =========================
   START
========================= */

displayBooks();

</script>


</body>

</html>
```
